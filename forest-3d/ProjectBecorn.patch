+bool AFurnitureAssembler::IsIngredientInZone(const AActor* Item) const
+{
+    if (IsOverlappingActor(Item)) return true;
+
+    // A Blueprint drop can restore collision after moving its mesh, without a cached overlap in the same frame.
+    const FVector Extent = AssemblerZone->GetUnscaledBoxExtent();
+    const FBox LocalZone(-Extent, Extent);
+    const FTransform& Transform = AssemblerZone->GetComponentTransform();
+    TInlineComponentArray<UPrimitiveComponent*> Components(Item);
+    for (const UPrimitiveComponent* Component : Components)
+        if (Component->IsRegistered() && Component->IsQueryCollisionEnabled() &&
+            LocalZone.IsInsideOrOn(Transform.InverseTransformPosition(Component->Bounds.Origin)))
+            return true;
+    return false;
+}
