+
+    if (const AActor* Ropes = RopeActor.Get())
+    {
+        if (const AMainPlayer* Player = Cast<AMainPlayer>(ReadObject(Ropes, TEXT("PlayerOnRopeLeft"))))
+            Left = Player->GetUniqueID();
+        if (const AMainPlayer* Player = Cast<AMainPlayer>(ReadObject(Ropes, TEXT("PlayerOnRopeRight"))))
+            Right = Player->GetUniqueID();
+        bLeftPulled = ReadFlag(Ropes, TEXT("IsActivated_L")) || ReadFlag(Ropes, TEXT("OneTimeInteract_L"));
+        bRightPulled = ReadFlag(Ropes, TEXT("Is Activated_R")) || ReadFlag(Ropes, TEXT("OneTimeInteract_R"));
+    }
+}
